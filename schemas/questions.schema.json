{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/content/generate-schemas.ts from src/shared/src/content (zod). Do not edit: run `npm run content:schemas`.",
  "title": "Unit question bank",
  "description": "courses/<course-id>/units/NN-<unit-id>/questions.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ]
          },
          "domainId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "stem": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "minItems": 2,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E",
                    "F"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "key",
                "text"
              ]
            }
          },
          "correct": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E",
                "F"
              ]
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "translations": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 35,
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "stem": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "minItems": 2,
                  "maxItems": 6,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "enum": [
                          "A",
                          "B",
                          "C",
                          "D",
                          "E",
                          "F"
                        ]
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "key",
                      "text"
                    ]
                  }
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "hint": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "stem",
                "options",
                "explanation"
              ]
            }
          }
        },
        "required": [
          "id",
          "type",
          "domainId",
          "skill",
          "topic",
          "stem",
          "options",
          "correct",
          "explanation"
        ]
      }
    }
  },
  "required": [
    "questions"
  ]
}
