{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/content/generate-schemas.ts from src/shared/src/content (zod). Do not edit: run `npm run content:schemas`.",
  "title": "Unit manifest",
  "description": "courses/<course-id>/units/NN-<unit-id>/unit.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "officialTitle": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "enum": [
        "logo",
        "sliders",
        "route",
        "book",
        "terminal",
        "exam",
        "check",
        "clock",
        "translate",
        "right",
        "flag",
        "trophy",
        "bulb",
        "alert",
        "diagram",
        "logout",
        "user",
        "bot",
        "tool",
        "file",
        "server",
        "braces",
        "loop",
        "shield",
        "target",
        "list",
        "git",
        "chat",
        "layers",
        "users",
        "star",
        "flame",
        "chart",
        "cards",
        "calendar",
        "bolt",
        "undo",
        "palette",
        "globe",
        "gift",
        "crown",
        "lock",
        "play",
        "search",
        "note",
        "eye",
        "sparkle",
        "puzzle",
        "gem",
        "bag",
        "grid",
        "eyeOff",
        "mail",
        "key",
        "userPlus",
        "sun",
        "moon",
        "monitor",
        "medal"
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lessons": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "labs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "quizPassRatio": {
      "default": 0.7,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "quizQuestionCount": {
      "default": 10,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "title",
    "summary",
    "icon",
    "color",
    "objectives",
    "lessons"
  ]
}
