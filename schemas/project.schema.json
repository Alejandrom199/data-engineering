{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/content/generate-schemas.ts from src/shared/src/content (zod). Do not edit: run `npm run content:schemas`.",
  "title": "Unit project",
  "description": "courses/<course-id>/units/NN-<unit-id>/project.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deliverables": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rubric": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion"
        ]
      }
    },
    "referenceSolution": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "title",
    "context",
    "requirements"
  ]
}
