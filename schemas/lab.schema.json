{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/content/generate-schemas.ts from src/shared/src/content (zod). Do not edit: run `npm run content:schemas`.",
  "title": "Guided lab",
  "description": "courses/<course-id>/units/NN-<unit-id>/labs/NN-<lab-id>.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 240
    },
    "icon": {
      "type": "string",
      "enum": [
        "logo",
        "sliders",
        "route",
        "book",
        "terminal",
        "exam",
        "check",
        "clock",
        "translate",
        "right",
        "flag",
        "trophy",
        "bulb",
        "alert",
        "diagram",
        "logout",
        "user",
        "bot",
        "tool",
        "file",
        "server",
        "braces",
        "loop",
        "shield",
        "target",
        "list",
        "git",
        "chat",
        "layers",
        "users",
        "star",
        "flame",
        "chart",
        "cards",
        "calendar",
        "bolt",
        "undo",
        "palette",
        "globe",
        "gift",
        "crown",
        "lock",
        "play",
        "search",
        "note",
        "eye",
        "sparkle",
        "puzzle",
        "gem",
        "bag",
        "grid",
        "eyeOff",
        "mail",
        "key",
        "userPlus",
        "sun",
        "moon",
        "monitor",
        "medal"
      ]
    },
    "domainId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "minItems": 2,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "codeLanguage": {
      "default": "text",
      "type": "string",
      "minLength": 1
    },
    "expectedOutput": {
      "type": "string"
    },
    "verify": {
      "type": "string",
      "minLength": 1
    },
    "successCriteria": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "title",
    "goal",
    "level",
    "estimatedMinutes",
    "icon",
    "domainId",
    "file",
    "steps",
    "code",
    "verify"
  ]
}
