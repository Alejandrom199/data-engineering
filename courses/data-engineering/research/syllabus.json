        },
        {
          "number": 2,
          "name": "Arquitectura de Computadores y Línea de Comandos (Linux)",
          "topics": ["Jerarquía de memoria", "I/O bound vs CPU bound", "Bash scripting", "Pipelines y flujos estándar", "grep", "awk"]
        },
        {
          "number": 3,
          "name": "Algoritmos y Complejidad (Big-O)",
          "topics": ["Notación Big-O", "Tablas Hash", "Árboles B/B+", "External Merge Sort"]
        }
      ],
      "project": "Procesador de Logs de Bajo Nivel (<50MB RAM)"
    },
    {
      "number": 2,
      "id": "programacion-adquisicion",
      "title": "Programación Robusta y Adquisición de Datos",
      "durationWeeks": 8,
      "phases": [
        {
          "number": 1,
          "name": "Python Avanzado y Gestión de Memoria",
          "topics": ["Iteradores y generadores", "Manejo estricto de excepciones", "Tipado estático con typing", "pytest", "Principios SOLID"]
        },
        {
          "number": 2,
          "name": "Redes, API y Tolerancia a Fallos",
          "topics": ["Modelo Cliente-Servidor", "HTTP/TCP", "Paginación por cursores", "Rate limiting", "Backoff exponencial", "Circuit Breaker"]
        }
      ],
      "project": "Extractor Resiliente de Alta Concurrencia (80%+ Coverage)"
    },
    {
      "number": 3,
