          "number": 1,
          "name": "OLTP y Motores Transaccionales",
          "topics": ["Normalización 1NF a 3NF", "Propiedades ACID", "Bloqueos y aislamiento", "Índices B-Tree vs Hash", "EXPLAIN ANALYZE"]
        },
        {
          "number": 2,
          "name": "SQL Analítico y CTEs",
          "topics": ["Common Table Expressions (CTEs)", "Funciones de Ventana", "Agregaciones analíticas"]
        },
        {
          "number": 3,
          "name": "Modelado Dimensional (Data Warehouse)",
          "topics": ["OLAP vs OLTP", "Esquema en Estrella", "Fact Tables", "Dimension Tables", "SCD Tipo 2"]
        }
      ],
      "project": "Pipeline ETL Hacia Data Warehouse Local (Idempotente)"
    },
    {
      "number": 4,
      "id": "sistemas-distribuidos-bigdata",
      "title": "Sistemas Distribuidos y Big Data",
      "durationWeeks": 8,
      "phases": [
        {
          "number": 1,
          "name": "Teoría de Sistemas Distribuidos y Formatos de Almacenamiento",
          "topics": ["Teorema CAP", "Formatos columnares (Parquet, ORC)", "Compresión", "Object Storage S3/MinIO", "Serialización"]
        },
        {
          "number": 2,
          "name": "Data Lakes y Data Lakehouses",
          "topics": ["Data Lake vs Lakehouse", "Particionado en disco", "Delta Lake / Apache Iceberg", "Time Travel"]
        },
        {
          "number": 3,
          "name": "Procesamiento Distribuido (Apache Spark)",
          "topics": ["Driver y Executers", "RDDs vs DataFrames", "Lazy Evaluation", "DAG de Spark", "Shuffles", "Data Skew", "Salting", "Broadcast Joins"]
        }
      ],
      "project": "Pipeline Distribuido de Alto Rendimiento en Spark y Lakehouse"
    },
    {
      "number": 5,
      "id": "orquestacion-calidad-dataops",
      "title": "Orquestación, Calidad y DataOps",
      "durationWeeks": 8,
      "phases": [
        {
