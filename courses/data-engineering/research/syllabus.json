        },
        {
          "number": 2,
          "name": "Calidad de Datos (Data Contracts) y Observabilidad",
          "topics": ["Pruebas unitarias de datos (Great Expectations)", "Detección de anomalías", "Circuit Breakers de datos", "Linaje"]
        },
        {
          "number": 3,
          "name": "Infraestructura como Código (IaC) y CI/CD",
          "topics": ["Docker", "Terraform", "GitHub Actions CI/CD", "Linters de código y SQL (sqlfluff)"]
        }
      ],
      "project": "Plataforma DataOps Automatizada y Contenerizada"
    },
    {
      "number": 6,
      "id": "streaming-tiempo-real",
      "title": "Streaming y Procesamiento en Tiempo Real",
      "durationWeeks": 8,
      "phases": [
        {
          "number": 1,
