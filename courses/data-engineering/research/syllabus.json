          "topics": ["Flink / Spark Structured Streaming", "Event-time vs Processing-time", "Ventanas (Tumbling/Sliding)", "Watermarks", "Late Data"]
        },
        {
          "number": 3,
          "name": "Arquitecturas Modernas (CDC y Kappa)",
          "topics": ["Change Data Capture (CDC / Debezium)", "Write-Ahead Logging (WAL)", "Arquitectura Kappa vs Lambda"]
